# koneko-web - the web frontend for a bancho.jar server.
# Copy this file to .env and adjust it. Everything here has a default, so an
# empty .env still starts.
#
# Only deployment settings live here. The texts of the site and the plugin
# settings live in .config/config.yml.

# Port this frontend listens on. Put nginx in front of it in production.
PORT=8305

# Your server domain, without a protocol. Used to build the API url and shown
# in the connect instructions on the front page.
DOMAIN=example.com

# Base url of the bancho.jar public API. Leave empty to use https://api.$DOMAIN
API_BASE_URL=

# DEV or PROD.
#   DEV  - .vue files are re-read on every request, cookies are not Secure
#          (so http://localhost works) and errors are verbose.
#   PROD - files are cached, cookies are Secure.
LEVEL=PROD

# Sent to the API as client_id, so sessions from this frontend are
# recognisable in the bancho.jar logs.
API_CLIENT_ID=koneko-web

# Registration on the website (/register). Turn it off to hide the form and the
# links to it. The backend has its own switch, WEB_REGISTRATION_ENABLED, which
# has the last word.
REGISTRATION_ENABLED=true

CAPTCHA_PROVIDER=NONE
CAPTCHA_SITE_KEY=

# FastLoad. Public page data (front page counters, leaderboard, profiles)
# is kept in memory and in the browser, so a page is painted instantly and
# only then refreshed from the API.
#   FASTLOAD_TTL_SECONDS        - served from memory without any API call.
#                                 0 turns the server side cache off.
#   FASTLOAD_STALE_SECONDS      - how much longer an old answer may be
#                                 served while it is refreshed in the
#                                 background.
#   FASTLOAD_CLIENT_TTL_SECONDS - how long a page may be restored from
#                                 localStorage before the fetch answers.
#                                 0 turns the browser side cache off.
FASTLOAD_TTL_SECONDS=15
FASTLOAD_STALE_SECONDS=120
FASTLOAD_CLIENT_TTL_SECONDS=600

# Event themes. A theme is fetched from a URL and then applied to every page,
# so both settings below live here rather than in the staff panel: they decide
# what the panel is allowed to do, and a switch the panel could flip itself
# would not be a limit on it.
#
# THEME_SOURCE_HOSTS - comma separated host names a theme may be fetched from.
#   Empty (the default) means no theme can be fetched at all. https is required
#   except for localhost, and a host that resolves to an address inside your
#   network is refused - otherwise the panel becomes a way to probe it.
#   Example: THEME_SOURCE_HOSTS=themes.example.com,localhost
THEME_SOURCE_HOSTS=

# THEME_ALLOW_CUSTOM_JS - whether a theme's custom_js runs in visitors'
#   browsers. Off by default.
#
#   The code never runs on your origin: it is confined to a sandboxed iframe
#   with an opaque origin, which cannot read the page, cannot read the session
#   cookie (it is HttpOnly anyway) and cannot call the API as the visitor. The
#   frame is drawn under the page and ignores clicks, and themes are not
#   applied on the login, register, settings or 2FA pages at all.
#
#   What remains, and what turning this on accepts: a theme source can make the
#   site look wrong and can waste a visitor's CPU. Themes that only set colours
#   and particles need nothing here - leave it off.
THEME_ALLOW_CUSTOM_JS=false
